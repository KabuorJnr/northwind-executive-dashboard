	partition FactOrders = m
		mode: import
		source =
				let
				    Source = Sql.Database(Server, Database),
				    Orders = Source{[Schema="dbo",Item="Orders"]}[Data],
				    Selected = Table.SelectColumns(Orders, {"OrderID", "CustomerID", "EmployeeID", "ShipVia", "OrderDate", "RequiredDate", "ShippedDate", "Freight", "ShipCity", "ShipCountry"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"OrderID", Int64.Type}, {"CustomerID", type text}, {"EmployeeID", Int64.Type}, {"ShipVia", Int64.Type}, {"OrderDate", type date}, {"RequiredDate", type date}, {"ShippedDate", type date}, {"Freight", Currency.Type}, {"ShipCity", type text}, {"ShipCountry", type text}}),
				    AddDaysToShip = Table.AddColumn(Typed, "DaysToShip", each if [ShippedDate] = null then null else Duration.Days([ShippedDate] - [OrderDate]), Int64.Type),
				    AddDaysLate = Table.AddColumn(AddDaysToShip, "DaysLate", each if [ShippedDate] = null then null else Duration.Days([ShippedDate] - [RequiredDate]), Int64.Type),
				    AddStatus = Table.AddColumn(AddDaysLate, "Delivery Status", each if [ShippedDate] = null then "Open" else if [ShippedDate] <= [RequiredDate] then "On time" else "Late", type text)
				in
				    AddStatus

	annotation PBI_ResultType = Table

	column DateWithSales = DimDate[Date] <= MAX ( FactOrders[OrderDate] )
		dataType: boolean
		isHidden
		lineageTag: 50ff4ebb-b6da-4688-8f34-73404c00ede1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition DimDate = m
		mode: import
		source =
				let
				    Source = Sql.Database(Server, Database),
				    Orders = Source{[Schema="dbo",Item="Orders"]}[Data],
				    MinDate = Date.From(List.Min(Orders[OrderDate])),
				    MaxDate = Date.From(List.Max(Orders[OrderDate])),
				    StartDate = #date(Date.Year(MinDate), 1, 1),
				    EndDate = #date(Date.Year(MaxDate), 12, 31),
				    Dates = List.Dates(StartDate, Duration.Days(EndDate - StartDate) + 1, #duration(1, 0, 0, 0)),
				    Base = Table.FromList(Dates, Splitter.SplitByNothing(), type table [Date = date]),
				    AddYear = Table.AddColumn(Base, "Year", each Date.Year([Date]), Int64.Type),
				    AddQuarterNo = Table.AddColumn(AddYear, "QuarterNumber", each Date.QuarterOfYear([Date]), Int64.Type),
				    AddQuarter = Table.AddColumn(AddQuarterNo, "Quarter", each "Q" & Text.From([QuarterNumber]), type text),
				    AddMonthNo = Table.AddColumn(AddQuarter, "MonthNumber", each Date.Month([Date]), Int64.Type),
				    AddMonth = Table.AddColumn(AddMonthNo, "Month", each Date.ToText([Date], [Format="MMM", Culture="en-US"]), type text),
				    AddYearMonthKey = Table.AddColumn(AddMonth, "YearMonthKey", each [Year] * 100 + [MonthNumber], Int64.Type),
				    AddYearMonth = Table.AddColumn(AddYearMonthKey, "Year Month", each Date.ToText([Date], [Format="MMM yyyy", Culture="en-US"]), type text),
				    AddYearQuarter = Table.AddColumn(AddYearMonth, "Year Quarter", each Text.From([Year]) & " " & [Quarter], type text),
				    AddYearQuarterKey = Table.AddColumn(AddYearQuarter, "YearQuarterKey", each [Year] * 10 + [QuarterNumber], Int64.Type),
				    AddWeekday = Table.AddColumn(AddYearQuarterKey, "Weekday", each Date.ToText([Date], [Format="ddd", Culture="en-US"]), type text),
				    AddWeekdayNo = Table.AddColumn(AddWeekday, "WeekdayNumber", each Date.DayOfWeek([Date], Day.Monday) + 1, Int64.Type)
				in
				    AddWeekdayNo

	annotation PBI_ResultType = Table

	partition FactSales = m
		mode: import
		source =
				let
				    Source = Sql.Database(Server, Database),
				    Details = Source{[Schema="dbo",Item="Order Details"]}[Data],
				    Orders = Source{[Schema="dbo",Item="Orders"]}[Data],
				    Joined = Table.NestedJoin(Details, {"OrderID"}, Orders, {"OrderID"}, "O", JoinKind.Inner),
				    Expanded = Table.ExpandTableColumn(Joined, "O", {"CustomerID", "EmployeeID", "ShipVia", "OrderDate"}),
				    Selected = Table.SelectColumns(Expanded, {"OrderID", "ProductID", "CustomerID", "EmployeeID", "ShipVia", "OrderDate", "UnitPrice", "Quantity", "Discount"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"OrderID", Int64.Type}, {"ProductID", Int64.Type}, {"CustomerID", type text}, {"EmployeeID", Int64.Type}, {"ShipVia", Int64.Type}, {"OrderDate", type date}, {"UnitPrice", Currency.Type}, {"Quantity", Int64.Type}, {"Discount", type number}}),
				    AddGross = Table.AddColumn(Typed, "GrossAmount", each [UnitPrice] * [Quantity], Currency.Type),
				    AddNet = Table.AddColumn(AddGross, "NetRevenue", each [UnitPrice] * [Quantity] * (1 - [Discount]), Currency.Type),
				    AddDiscount = Table.AddColumn(AddNet, "DiscountAmount", each [GrossAmount] - [NetRevenue], Currency.Type)
				in
				    AddDiscount

	annotation PBI_ResultType = Table

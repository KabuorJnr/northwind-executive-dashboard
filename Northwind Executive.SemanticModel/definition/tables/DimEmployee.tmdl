	partition DimEmployee = m
		mode: import
		source =
				let
				    Source = Sql.Database(Server, Database),
				    Employees = Source{[Schema="dbo",Item="Employees"]}[Data],
				    Selected = Table.SelectColumns(Employees, {"EmployeeID", "FirstName", "LastName", "Title", "Country"}),
				    AddName = Table.AddColumn(Selected, "Sales Rep", each [FirstName] & " " & [LastName], type text),
				    Final = Table.SelectColumns(AddName, {"EmployeeID", "Sales Rep", "Title", "Country"}),
				    Renamed = Table.RenameColumns(Final, {{"Country", "Rep Country"}, {"Title", "Rep Title"}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"EmployeeID", Int64.Type}, {"Rep Title", type text}, {"Rep Country", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table

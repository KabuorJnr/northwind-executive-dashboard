		annotation SummarizationSetBy = Automatic

	column Product
		dataType: string
		lineageTag: 220a7b7a-bd68-4bda-bc91-386f56b4d698
		summarizeBy: none
		sourceColumn: Product

		annotation SummarizationSetBy = Automatic

	column Category
		dataType: string
		lineageTag: 33c34fa6-fbe1-48b8-9643-4e66d431178d
		summarizeBy: none

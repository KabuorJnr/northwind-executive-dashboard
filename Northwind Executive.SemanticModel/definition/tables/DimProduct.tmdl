	column 'Product Status'
		dataType: string
		lineageTag: 82039058-fd00-4da1-a9bf-35958cee3bcc
		summarizeBy: none
		sourceColumn: Product Status

		annotation SummarizationSetBy = Automatic

	partition DimProduct = m
		mode: import
		source =
				let
				    Source = Sql.Database(Server, Database),
				    Products = Source{[Schema="dbo",Item="Products"]}[Data],
				    Categories = Source{[Schema="dbo",Item="Categories"]}[Data],
				    Joined = Table.NestedJoin(Products, {"CategoryID"}, Categories, {"CategoryID"}, "Cat", JoinKind.LeftOuter),
				    Expanded = Table.ExpandTableColumn(Joined, "Cat", {"CategoryName"}, {"Category"}),
				    Selected = Table.SelectColumns(Expanded, {"ProductID", "ProductName", "Category", "Discontinued"}),
				    Renamed = Table.RenameColumns(Selected, {{"ProductName", "Product"}}),
				    Status = Table.AddColumn(Renamed, "Product Status", each if [Discontinued] = true then "Discontinued" else "Active", type text),
				    Final = Table.RemoveColumns(Status, {"Discontinued"}),
				    Typed = Table.TransformColumnTypes(Final, {{"ProductID", Int64.Type}, {"Product", type text}, {"Category", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table
